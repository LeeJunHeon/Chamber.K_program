{
    "// ================================================================": "",
    "// Chamber-K 사용자 설정 파일 (config_user.json)": "",
    "// - 이 파일을 수정하고 프로그램을 재시작하면 설정이 적용됩니다.": "",
    "// - 이 파일이 없거나 오류가 있으면 config.py 기본값이 사용됩니다.": "",
    "// - // 로 시작하는 줄은 주석으로 처리되어 무시됩니다.": "",
    "// - 히터 한계값(DAC 상한/램프/홀드백/과온)의 단일 출처는 이 파일입니다.": "",
    "//   PLC 접속 시 아래 값이 D레지스터로 전송되므로, XG5000 모니터로 직접": "",
    "//   쓸 필요가 없습니다. 값을 고친 뒤에는 반드시 프로그램을 재시작하세요.": "",
    "// ================================================================ ": "",

    "// ------- 시리얼 포트 설정 -------": "",
    "// MFC 연결 포트 (장치관리자에서 확인)": "",
    "MFC_PORT": "COM10",
    "MFC_BAUD": 9600,

    "// DC Power 연결 포트": "",
    "DC_PORT": "COM11",
    "DC_BAUDRATE": 9600,

    "// PLC 연결 포트": "",
    "PLC_PORT": "COM9",

    "// ------- DC 파워 감시 설정 -------": "",
    "// DC 파워 이탈 허용 비율 (0.10 = ±10%)": "",
    "DC_POWER_ERROR_RATIO": 0.10,
    "// DC 파워 이탈 연속 횟수 - 이 횟수 초과 시 공정 중단": "",
    "DC_POWER_ERROR_MAX_COUNT": 5,
    "// DC 저전류 판단 기준값 (A) - 이 값 이하이면 저전류로 감지": "",
    "DC_MIN_CURRENT_ABORT": 0.05,
    "// DC 저전류 연속 횟수 - 이 횟수 초과 시 공정 중단": "",
    "DC_MIN_CURRENT_ABORT_COUNT": 10,
    "// DC 램프업 무응답 판단 시간 (초) - 이 시간 이상 출력 없으면 공정 중단": "",
    "DC_FAIL_MAX_TICKS": 15,
    "// DC Power Delay: SP1 도달 후 Shutter Delay 직전 안정화 대기 시간(초). 이 구간 동안 ±% 이탈 abort 비활성.": "",
    "DC_POWER_DELAY_SEC": 300,

    "// ------- RF 파워 감시 설정 -------": "",
    "// RF For.P 이탈 허용 비율 (0.10 = ±10%) - MAINTAINING 중만 감시": "",
    "RF_POWER_ERROR_RATIO": 0.10,
    "// RF For.P 이탈 연속 횟수 - 이 횟수 초과 시 공정 중단": "",
    "RF_POWER_ERROR_MAX_COUNT": 5,
    "// RF 램프업 무응답 판단 시간 (초)": "",
    "RF_FAIL_MAX_TICKS": 10,
    "// RF Ref.P 임계값 (W) - 이 값 이상이면 대기 시작 (전 구간 감시)": "",
    "RF_REFP_ABORT_THRESHOLD": 3.0,
    "// RF Ref.P 대기 허용 시간 (초) - 이 시간 내 안정 안 되면 공정 중단": "",
    "RF_REFP_WAIT_SEC": 60,

    "// ------- MFC 감시 설정 -------": "",
    "// 가스 유량 이탈 허용 비율 (0.10 = ±10%) - Process Time에서만 감시": "",
    "FLOW_ERROR_TOLERANCE": 0.10,
    "// 가스 유량 이탈 연속 횟수 - 이 횟수 초과 시 구글챗 알림 (공정 유지)": "",
    "FLOW_ERROR_MAX_COUNT": 5,
    "// 압력 이탈 허용 비율 (0.10 = ±10%) - Process Time에서만 감시": "",
    "MFC_PRESSURE_WARN_RATIO": 0.10,
    "// 압력 이탈 연속 횟수 - 이 횟수 초과 시 구글챗 알림 (공정 유지)": "",
    "MFC_PRESSURE_WARN_COUNT": 5,

    "// ------- 히터 설정 -------": "",
    "// 히터 기능 사용 여부": "",
    "HEATER_ENABLED": true,
    "// TC 변환 스케일: 0.1 = 0.1도 단위 / 1.0 = 1도 단위": "",
    "HEATER_TEMP_SCALE": 0.1,
    "// 워치독 갱신 주기(ms) - PLC TON 설정의 1/3 이하 권장": "",
    "HEATER_WD_PERIOD_MS": 3000,
    "// UI 목표 온도 입력 상한(°C)": "",
    "// ※ HEATER_SV_LIMIT_C 를 넘으면 그 값으로 자동 하향된다": "",
    "HEATER_MAX_TEMP": 700.0,
    "// 온도 도달 판정 허용 편차(°C)": "",
    "HEATER_SOAK_TOLERANCE": 1.0,
    "// [공정 레시피 전용] 히터 목표 도달 후 이 시간 유지되어야 다음 단계로 진행": "",
    "// ※ 히터 레시피(heater_recipe.py)는 이 값을 쓰지 않는다 — RAMP 완료 즉시 SOAK": "",
    "HEATER_SOAK_TIME_SEC": 60,
    "// 승온 대기 최대 시간(초) - 초과 시 공정 중단": "",
    "// ※ 고온 목표일수록 승온이 오래 걸린다. 목표 온도를 올리면 이 값도 함께 검토할 것": "",
    "HEATER_WAIT_TIMEOUT_SEC": 5400,

    "// --- PLC로 전송되는 한계값 (프로그램 접속 시 D레지스터에 기록) ---": "",
    "// ※ 아래 세 쌍은 서로 물려 있다. 하나만 바꾸면 lib/config.py 의": "",
    "//   _validate_heater_config() 가 자동으로 클램프하고 콘솔에 경고를 남긴다.": "",
    "//     HEATER_MAX_TEMP   ≤ HEATER_SV_LIMIT_C": "",
    "//     HEATER_OT_LIMIT_C ≥ HEATER_SV_LIMIT_C + 20  (권장 +50)": "",
    "//     HEATER_MV_LIMIT   ≤ HEATER_MV_ABS_MAX": "",

    "// 출력 0% 지점. PLC K1227(MV 최소값)과 반드시 일치시킬 것": "",
    "// 이 값 미만의 DAC 에서는 VARITAP 이 출력하지 않는다(데드존)": "",
    "HEATER_MV_MIN": 400,

    "// 코드가 어떤 경우에도 넘지 않는 절대 상한.": "",
    "// DAC 물리 최대는 1600(= 4V = VARITAP 출력 100%). 그보다 낮게 잡아": "",
    "// 오타나 실수로 전출력이 나가는 것을 막는 안전벽으로 쓴다.": "",
    "// HEATER_MV_LIMIT 보다 반드시 커야 한다.": "",
    "HEATER_MV_ABS_MAX": 1300,

    "// → D00018. 실제 운전 상한. PID 가 낼 수 있는 최대 출력.": "",
    "// 상한이 높을수록 고온에서 승온 속도를 유지할 수 있지만,": "",
    "// TC 고장 등으로 PID 가 계속 올리려 할 때 흐르는 최대 전류도 그만큼 커진다.": "",
    "// 목표 온도를 바꾸면 이 값이 충분한지 다시 확인할 것.": "",
    "HEATER_MV_LIMIT": 1200,

    "// → D00013. PLC 쪽 목표 온도 소프트 상한(°C). HEATER_MAX_TEMP 이상일 것": "",
    "HEATER_SV_LIMIT_C": 700.0,
    "// → D00020. 램프 속도(°C/min). PLC 분해능이 6°C/min 이라 6의 배수로 쓸 것": "",
    "// 실제 승온 속도 = min(이 값, 그 온도에서 히터가 낼 수 있는 속도)": "",
    "// 즉 이 값은 '상한'이지 '하한'이 아니다. 낮추면 느려지고, 올려도 히터 능력을 넘지 못한다.": "",
    "HEATER_RAMP_RATE_C_PER_MIN": 12.0,
    "// → D00021. 홀드백 폭(°C). PV 가 이만큼 뒤처지면 램프 목표가 기다린다.": "",
    "// 적분 와인드업을 막는 장치이므로 함부로 키우지 말 것.": "",
    "HEATER_HOLDBACK_C": 2.0,
    "// → D00026. 과온 트립(°C). 래치되므로 풀려면 이상 리셋이 필요하다.": "",
    "HEATER_OT_LIMIT_C": 750.0,
    "// → D00027. 목표 도달 전 감속을 시작할 폭(°C)": "",
    "_HEATER_COOLDOWN_TARGET_C": "마지막 스텝 목표가 이 온도 이하면 냉각 스텝 — 램프·도달 판정 없이 soak 시간만 기다린다. 히터는 식는 속도를 제어할 수 없기 때문",
    "HEATER_COOLDOWN_TARGET_C": 30.0,

    "HEATER_SLOW_ZONE_C": 10.0,
    "// → D00028. 감속 구간 램프 속도(°C/min). 최소 6.0": "",
    "HEATER_SLOW_RATE_C_PER_MIN": 6.0,

    "// 접속 시 위 값들을 PLC에 쓸지 여부. false면 PLC 현재값을 그대로 사용": "",
    "HEATER_PUSH_CONFIG": true,

    "// --- 전류 추정 계수 (화면/로그 표시용. 제어에는 쓰이지 않음) ---": "",
    "// VARITAP 은 위상제어라 전류가 DAC 카운트에 비례하지 않는다.": "",
    "// 점호각이 카운트에 선형이라고 보고 위상제어 실효값 공식을 쓴다:": "",
    "//     a = pi x (MV_FULL - MV) / (MV_FULL - MV_ZERO)": "",
    "//     I = SCALE x sqrt[(pi - a + sin(2a)/2) / pi]": "",
    "// MV_ZERO = 출력 0 인 카운트(점호각 180도), MV_FULL = 전출력(점호각 0도).": "",
    "// SCALE 은 전출력일 때의 전류[A] 이며, 이 값만 재측정으로 갱신하면 된다.": "",
    "// 실측 앵커(2026-09-01) — 셋 다 오차 6% 이내:": "",
    "//   MV 520 -> 11.5A (저온) · MV 600 -> 22.4A (저온) · MV 800 -> 59.8A (600도 유지)": "",
    "// ※ 앵커 밖(600도 이상)은 외삽이므로 그 구간은 전면 전류계를 우선할 것.": "",
    "//   소자 노화로 저항이 변하면 SCALE 을 재측정해서 갱신한다.": "",
    "HEATER_CURRENT_MV_ZERO": 400,
    "HEATER_CURRENT_MV_FULL": 1600,
    "HEATER_CURRENT_SCALE": 135.1,

    "// ------- 히터 레시피 / 로깅 -------": "",
    "// 레시피 CSV 형식 (UTF-8, 첫 줄이 헤더):": "",
    "//   step,target_c,ramp_c_per_min,soak_min": "",
    "//   1,150,12,10   → 12°C/min 으로 150°C 까지 올린 뒤 10분 유지": "",
    "//   ramp_c_per_min 은 6의 배수 권장(6 미만은 6으로 보정), soak_min 0 이면 도달만 확인": "",
    "//   마지막 스텝의 target_c 가 30 이하이면 냉각 스텝으로 보고 도달 대기 없이 시간만 기다림": "",

    "// 레시피 파일 선택 다이얼로그의 초기 폴더. 빈 문자열이면 프로그램 폴더": "",
    "HEATER_RECIPE_DIR": "",
    "// 히터 운전 중 CSV 로깅 사용 여부": "",
    "HEATER_LOG_ENABLED": true,
    "// CSV 기록 주기(ms). 허용 1000~60000": "",
    "HEATER_LOG_PERIOD_MS": 3000,
    "// 레시피 최대 스텝 수": "",
    "HEATER_RECIPE_MAX_STEPS": 20,
    "// 레시피 종료 후 마지막 목표 온도를 유지할지 여부(false면 히터 정지)": "",
    "HEATER_RECIPE_HOLD_AT_END": false
}